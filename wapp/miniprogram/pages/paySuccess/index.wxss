.success-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx;
  min-height: 100vh;
  background-color: #fff;
}

/* 成功图标 */
.icon-section {
  margin-bottom: 30rpx;
}

.success-icon-fallback {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #07c160;
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

/* 订单信息卡片 */
.info-card {
  width: 100%;
  background-color: #f8f8f8;
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
  margin-bottom: 60rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid #eee;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #e74c3c;
}

/* 按钮 */
.btn-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  background-color: #1677ff;
}

.home-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  color: #666;
  background-color: #f0f0f0;
}
