.pay-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
  box-sizing: border-box;
}

/* ===== 通用：金额 & 订单号 ===== */
.amount-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 10rpx;
  padding-top: 40rpx;
}
.amount-section.small { padding-top: 20rpx; }

.amount-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.amount-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
}

.order-info {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.order-label {
  font-size: 26rpx;
  color: #999;
}

/* ===== 场景一：选择支付方式 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.pay-methods {
  margin-top: 20rpx;
}

.method-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.method-item.selected {
  border-color: #1677ff;
  background-color: #f0f7ff;
}

.method-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.wx-icon { background-color: #07c160; }

.alipay-icon { background-color: #1677ff; }

.method-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.method-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.method-desc {
  font-size: 24rpx;
  color: #999;
}

.method-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  flex-shrink: 0;
}

.method-check.checked {
  background-color: #1677ff;
  border-color: #1677ff;
}

/* ===== 场景二 & 三：支付标签 ===== */
.method-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
}

.tag-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #1677ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 12rpx;
}

.wx-tag { background-color: #07c160; }

/* ===== 场景二：支付宝二维码 ===== */
.qr-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.qr-image {
  width: 400rpx;
  height: 400rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
}

.qr-tip {
  font-size: 30rpx;
  color: #333;
  margin-top: 30rpx;
  font-weight: 500;
}

.qr-tip-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.qr-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.qr-loading text {
  font-size: 28rpx;
  color: #999;
}

.qr-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.error-text {
  font-size: 28rpx;
  color: #e74c3c;
  margin-bottom: 30rpx;
}

.retry-btn {
  width: 300rpx;
}

/* ===== 场景三：微信支付 ===== */
.wechat-pay-info {
  display: flex;
  justify-content: center;
  padding: 60rpx 0 40rpx;
}

.wechat-tip {
  font-size: 28rpx;
  color: #666;
}

/* ===== 按钮 ===== */
.btn-section {
  width: 100%;
  margin-top: 40rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  background-color: #1677ff;
}

.confirm-btn[disabled] {
  background-color: #ccc;
}

.pay-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  background-color: #1677ff;
}

.wx-pay-btn {
  background-color: #07c160;
}

.back-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
  color: #666;
  background-color: transparent;
  border: 2rpx solid #ddd;
  margin-top: 16rpx;
}

/* ===== 支付方式图标 ===== */
.method-icon.wx-icon,
.method-icon.alipay-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}
